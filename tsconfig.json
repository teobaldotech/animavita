{
  "name": "animavita",
  "private": true,
  "packageManager": "pnpm@10",
  "scripts": {
    "// Development": "",

    "dev": "pnpm --filter backend start:dev",
    "dev:debug": "pnpm --filter backend start:debug",

    "// Build": "",

    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "build:backend": "pnpm --filter backend build",
    "build:schemas": "pnpm --filter validation-schemas build",

    "// Start": "",

    "start": "pnpm --filter backend start",
    "start:prod": "pnpm --filter backend start:prod",

    "// TypeScript": "",

    "type-check": "tsc --build --noEmit",
    "type-check:watch": "tsc --build --watch",

    "// Tests": "",

    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:cov": "pnpm -r test:cov",
    "test:e2e": "pnpm --filter backend test:e2e",

    "// Lint": "",

    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint --fix",

    "// Format": "",

    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "// Docker": "",

    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",

    "// Database": "",

    "db:logs": "docker compose logs -f mongodb",
    "db:shell": "docker exec -it animavita_mongo mongosh",

    "// LocalStack": "",

    "s3:logs": "docker compose logs -f localstack",
    "s3:list-buckets": "docker exec animavita_localstack awslocal s3 ls",
    "s3:create-bucket": "docker exec animavita_localstack awslocal s3 mb s3://animavita-uploads",

    "// Clean": "",

    "clean": "rimraf apps/**/dist shared/**/dist",
    "clean:all": "rimraf node_modules apps/**/dist shared/**/dist .turbo",

    "// CI": "",

    "ci": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  }
}
